import { Palette, Button, VerticalBox } from "std-widgets.slint";
import { AppSize } from "globals.slint";
import { PageDashboard, Pages, NavState } from "pages/dashboard.slint";
import { PageSystem, SystemPageData, AttrMinMax } from "pages/system.slint";
import { BrandBar, NavBar } from "widgets/top_nav.slint";
import { TabStrip } from "widgets/cyber.slint";
import { PageAbout } from "pages/about.slint";
import { PageFans } from "pages/fans.slint";
import { PageAnime, AnimePageData } from "pages/anime.slint";
import { PageSlash, SlashPageData } from "pages/slash.slint";
import { Theme } from "widgets/theme.slint";
import { PageAura } from "pages/aura.slint";
import { PageGPU, GPUPageData } from "pages/gpu.slint";
import { PageBattery } from "pages/battery.slint";
import { Node } from "widgets/graph.slint";
export { Node }
import { FanPageData, FanType, Profile } from "types/fan_types.slint";
export { FanPageData, FanType, Profile }
import { AuraPageData, AuraDevType, LaptopAuraPower, AuraPowerState, PowerZones, AuraEffect } from "types/aura_types.slint";
export { AuraPageData, AuraDevType, LaptopAuraPower, AuraPowerState, PowerZones, AuraEffect }
import { PageAppSettings, AppSettingsPageData, GlobalShortcutStatus } from "pages/app_settings.slint";

export { AppSize, AttrMinMax, SystemPageData, AnimePageData, SlashPageData, AppSettingsPageData, GlobalShortcutStatus, GPUPageData }
export { NavState, Pages }

export component MainWindow inherits Window {
    title: device_name != "" ? "ROG Control Center — " + device_name : "ROG Control Center";
    always-on-top: true;
    default-font-family: "Noto Sans";
    default-font-size: Theme.font-base;
    default-font-weight: 400;
    icon: @image-url("../data/rog-control-center.png");
    // Availability flags, indexed by the `Pages` global. The top navigation
    // groups them into fewer tabs, but the model itself is unchanged.
    in property <[bool]> sidebar_items_available: [
        true, // Dashboard
        true, // System Control
        true, // Keyboard Aura
        true, // AniMe Matrix
        true, // Slash Lighting
        true, // Fan Curves
        true, // GPU Configuration
        true, // Battery Info
        true, // App Settings
        true, // About
    ];
    // Lighting group: the Aura page doubles as the entry point, and this strip
    // switches between the three lighting pages from any of them.
    private property <bool> in_lighting_group:
        NavState.page == Pages.aura || NavState.page == Pages.anime
        || NavState.page == Pages.slash;
    private property <int> lighting_tab:
        NavState.page == Pages.anime ? 1 : (NavState.page == Pages.slash ? 2 : 0);
    private property <bool> show_notif;
    in property <string> device_name: "";
    // Shown in the brand bar badge; set from the crate version at startup.
    in property <string> version: "";
    private property <bool> fade_cover;
    private property <bool> toast: false;
    private property <string> toast_text: "I show when something is waiting";
    callback show_toast(string);
    show_toast(text) => {
        toast = text != "";
        toast_text = text;
    }
    callback clear_toast_if_matches(string);
    clear_toast_if_matches(text) => {
        if (toast && toast_text == text) {
            toast = false;
            toast_text = "";
        }
    }
    callback exit-app();
    callback show_notification(bool);
    show_notification(yes) => {
        show_notif = yes;
        fade_cover = yes;
    }
    callback external_colour_change();
    external_colour_change() => {
        aura.external_colour_change();
    }

    init => {
        // The whole app is designed for the dark dashboard look.
        Palette.color-scheme = ColorScheme.dark;
    }

    width: AppSize.width;
    height: AppSize.height;
    background: Theme.surface-base;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        BrandBar {
            device-name: root.device_name;
            version: root.version;
            quit => {
                root.exit-app();
            }
        }

        NavBar {
            available: root.sidebar_items_available;
            lighting-available: root.sidebar_items_available[Pages.aura]
                || root.sidebar_items_available[Pages.anime]
                || root.sidebar_items_available[Pages.slash];
            current <=> NavState.page;
            selected(page) => {
                NavState.page = page;
            }
        }

        content := Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            background: Theme.surface-base;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                if root.in_lighting_group: Rectangle {
                    height: 50px;
                    background: Theme.surface-base;

                    HorizontalLayout {
                        padding-left: Theme.space-lg;
                        padding-right: Theme.space-lg;
                        padding-top: Theme.space-sm;
                        padding-bottom: Theme.space-sm;
                        alignment: start;
                        cross-axis-alignment: center;

                        TabStrip {
                            width: 420px;
                            accent: Theme.accent-lighting;
                            model: [@tr("Menu2" => "Aura"), @tr("Menu3" => "AniMe"), @tr("Menu4" => "Slash")];
                            current: root.lighting_tab;
                            selected(i) => {
                                NavState.page = i == 0 ? Pages.aura : (i == 1 ? Pages.anime : Pages.slash);
                            }
                        }

                        Rectangle {}
                    }
                }

                page-area := Rectangle {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;

                    if(NavState.page == Pages.dashboard): PageDashboard {
                        width: parent.width;
                        height: parent.height;
                        available: root.sidebar_items_available;
                        nav-target <=> NavState.page;
                    }

                    if(NavState.page == Pages.system): page := PageSystem {
                        width: parent.width;
                        height: parent.height;
                    }

                    /*if(NavState.page == 1):*/ aura := PageAura {
                        width: parent.width;
                        height: parent.height;
                        visible: NavState.page == Pages.aura;
                    }

                    if(NavState.page == Pages.anime): PageAnime {
                        width: parent.width;
                        height: parent.height;
                        visible: NavState.page == Pages.anime;
                    }

                    if(NavState.page == Pages.slash): PageSlash {
                        width: parent.width;
                        height: parent.height;
                        visible: NavState.page == Pages.slash;
                    }

                    if(NavState.page == Pages.fans): fans := PageFans {
                        width: parent.width;
                        height: parent.height;
                        visible: NavState.page == Pages.fans;
                    }

                    if(NavState.page == Pages.gpu): PageGPU {
                        width: parent.width;
                        height: parent.height;
                        visible: NavState.page == Pages.gpu;
                    }

                    if(NavState.page == Pages.battery): PageBattery {
                        width: parent.width;
                        height: parent.height;
                        visible: NavState.page == Pages.battery;
                    }

                    if(NavState.page == Pages.settings): PageAppSettings {
                        width: parent.width;
                        height: parent.height;
                        visible: NavState.page == Pages.settings;
                    }

                    if(NavState.page == Pages.about): PageAbout {
                        width: parent.width;
                        height: parent.height;
                        visible: NavState.page == Pages.about;
                    }

                    if toast: Rectangle {
                        x: Theme.space-lg;
                        y: parent.height - self.height - Theme.space-lg;
                        width: parent.width - Theme.space-lg * 2;
                        height: 40px;
                        opacity: 1.0;
                        border-radius: Theme.radius-md;
                        background: Theme.surface-card;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: Colors.black.with-alpha(0.4);
                        TouchArea {
                            height: 100%;
                            width: 100%;
                            clicked => {
                                toast = false;
                            }
                        }

                        Text {
                            color: Theme.text-control;
                            text: root.toast_text;
                            font-size: Theme.font-md;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    if fade_cover: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Colors.black;
        opacity: 0.6;
        TouchArea {
            height: 100%;
            width: 100%;
            clicked => {
                if (show_notif) {
                    show_notif = false;
                }
                fade_cover = false;
            }
        }
    }


    // // TODO: or use Dialogue
    if show_notif: Rectangle {
        x: root.width / 8;
        y: root.height / 8;
        height: (root.height / 8) * 6;
        width: (root.width / 8) * 6;
        TouchArea {
            height: 100%;
            width: 100%;
            clicked => {
                show_notif = false;
                exit-app();
            }
        }

        // TODO: add properties to display
        Rectangle {
            height: 100%;
            width: 100%;
            background: Theme.surface-base;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            Text {
                color: Theme.text;
                text: "Click here to exit";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if SomeError.error_message != "": Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.surface-base;

        VerticalBox {
            spacing: Theme.space-md;
            padding: Theme.space-xl;

            Text {
                text: "⚠";
                font-size: 32px;
                horizontal-alignment: TextHorizontalAlignment.center;
            }

            Text {
                text <=> SomeError.error_message;
                font-size: Theme.font-lg;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: TextHorizontalAlignment.center;
                wrap: word-wrap;
            }

            Text {
                text <=> SomeError.error_help;
                font-size: Theme.font-base;
                color: Theme.text-muted;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
                wrap: word-wrap;
            }
        }
    }
}

export global SomeError {
    in property <string> error_message: "";
    in property <string> error_help: "";
}
