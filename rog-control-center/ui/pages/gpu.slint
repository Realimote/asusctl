// GPU page: mode switching, reserved memory and the related toggles.
import { ScrollView } from "std-widgets.slint";
import { SectionCard } from "../widgets/modern.slint";
import { SectionTitle, SectionHint, OptionCard, Select, ToggleRow } from "../widgets/cyber.slint";
import { Theme } from "../widgets/theme.slint";

export global GPUPageData {
    in-out property <int> gpu_mode_index: 0; // index into gpu_modes
    in-out property <[string]> gpu_modes: []; // available modes, in display order
    in-out property <bool> gpu_switchable: false; // false when no GPU switch exists
    in-out property <bool> gpu_dropdown_enabled: true; // false when GPU switch is in progress
    callback cb_set_gpu_mode(int);

    in-out property <bool> has_xgm_led: false; // true when XG Mobile LED is present
    in-out property <bool> xgm_led_enabled: false; // current LED state
    callback cb_set_xgm_led_enabled(bool);

    in-out property <bool> disable_nvidia_powerd_on_battery: true;
    callback cb_disable_nvidia_powerd_on_battery(bool);

    in-out property <int> apu_mem_index: -1; // -1 when apu_mem is not available
    in-out property <[string]> apu_mem_choices: []; // available choices, in display order
    in-out property <bool> apu_mem_present: false; // false when apu_mem is not available
    callback cb_set_apu_mem(int);
}

export component PageGPU inherits Rectangle {
    clip: true;

    // Rows inside a section card cannot rely on `horizontal-stretch`: nested
    // layouts there measure their cross axis from the content, so the width has
    // to be derived. Rows here all live inside a card, so they get the page
    // content box minus the card padding.
    property <length> row-width: root.width - Theme.space-lg * 2 - Theme.space-md * 2;
    property <int> mode-count: GPUPageData.gpu_modes.length;
    property <length> mode-card-width: root.mode-count > 0
        ? (root.row-width - Theme.space-sm * (root.mode-count - 1)) / root.mode-count
        : root.row-width;

    property <string> current-mode-label:
        GPUPageData.gpu_modes.length > 0
            && GPUPageData.gpu_mode_index >= 0
            && GPUPageData.gpu_mode_index < GPUPageData.gpu_modes.length
        ? root.gpu_label(GPUPageData.gpu_modes[GPUPageData.gpu_mode_index])
        : "";

    function gpu_label(mode: string) -> string {
        if (mode == "Integrated") { return @tr("gpumode" => "iGPU only"); }
        if (mode == "Ultimate") { return @tr("gpumode" => "dGPU only"); }
        if (mode == "Hybrid") { return @tr("gpumode" => "Hybrid"); }
        return mode;
    }

    ScrollView {
        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-md;
            alignment: start;

            SectionTitle {
                icon: @image-url("../icons/monitor.svg");
                accent: Theme.accent-gpu;
                title: @tr("Internal/Discrete GPU");
                status: root.current-mode-label;
            }

            if !GPUPageData.gpu_switchable: SectionCard {
                SectionHint {
                    text: @tr("This device has no switchable GPU.");
                }
            }

            if GPUPageData.gpu_switchable: SectionCard {
                SectionTitle {
                    icon: @image-url("../icons/zap.svg");
                    accent: Theme.accent-gpu;
                    title: @tr("GPU mode");
                    status: root.current-mode-label;
                }

                HorizontalLayout {
                    width: root.row-width;
                    spacing: Theme.space-sm;

                    for m[i] in GPUPageData.gpu_modes: OptionCard {
                        width: root.mode-card-width;
                        accent: Theme.accent-gpu;
                        interactive: GPUPageData.gpu_dropdown_enabled;
                        icon: m == "Integrated" ? @image-url("../icons/leaf.svg")
                            : (m == "Ultimate" ? @image-url("../icons/gamepad-2.svg")
                            : @image-url("../icons/monitor.svg"));
                        label: root.gpu_label(m);
                        selected: GPUPageData.gpu_mode_index == i;
                        clicked => {
                            GPUPageData.cb_set_gpu_mode(i);
                        }
                    }
                }

                SectionHint {
                    text: @tr("Note: Changes take effect after a reboot. The dropdown always shows the current mode.");
                }
            }

            if GPUPageData.apu_mem_present: SectionCard {
                SectionTitle {
                    icon: @image-url("../icons/memory-stick.svg");
                    accent: Theme.accent-gpu;
                    title: @tr("Reserved GPU memory");
                }

                HorizontalLayout {
                    width: root.row-width;
                    spacing: Theme.space-sm;

                    Rectangle {}

                    Select {
                        min-width: 200px;
                        accent: Theme.accent-gpu;
                        model <=> GPUPageData.apu_mem_choices;
                        current-index <=> GPUPageData.apu_mem_index;
                        text: GPUPageData.apu_mem_index >= 0
                            && GPUPageData.apu_mem_index < GPUPageData.apu_mem_choices.length
                            ? GPUPageData.apu_mem_choices[GPUPageData.apu_mem_index] : "";
                        selected(i) => {
                            GPUPageData.cb_set_apu_mem(i);
                        }
                    }
                }

                SectionHint {
                    text: @tr("Note: Reserved GPU memory changes take effect after a reboot.");
                }
            }

            SectionCard {
                SectionTitle {
                    icon: @image-url("../icons/sliders-horizontal.svg");
                    accent: Theme.accent-gpu;
                    title: @tr("Graphics options");
                }

                if GPUPageData.has_xgm_led: ToggleRow {
                    width: root.row-width;
                    accent: Theme.accent-gpu;
                    text: @tr("XG Mobile LED");
                    checked <=> GPUPageData.xgm_led_enabled;
                    toggled(checked) => {
                        GPUPageData.cb_set_xgm_led_enabled(checked);
                    }
                }

                // Disable nvidia-powerd on battery toggle
                ToggleRow {
                    width: root.row-width;
                    accent: Theme.accent-gpu;
                    text: @tr("Disable nvidia-powerd on battery");
                    checked <=> GPUPageData.disable_nvidia_powerd_on_battery;
                    toggled(checked) => {
                        GPUPageData.cb_disable_nvidia_powerd_on_battery(checked);
                    }
                }
            }
        }
    }
}
