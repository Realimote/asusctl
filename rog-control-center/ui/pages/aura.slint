// Keyboard Aura page: effect selection, two colour pickers and the power-zone
// configuration panel.
import { ScrollView } from "std-widgets.slint";
import { SectionCard } from "../widgets/modern.slint";
import { SectionTitle, Select, GhostButton } from "../widgets/cyber.slint";
import { Theme } from "../widgets/theme.slint";
import { ColourSlider } from "../widgets/colour_picker.slint";
import { AuraPageData, AuraDevType, PowerZones, LaptopAuraPower, AuraEffect } from "../types/aura_types.slint";
import { AuraPowerGroup, AuraPowerGroupOld } from "../widgets/aura_power.slint";

export component PageAura inherits Rectangle {
    property <bool> show_aura_power: false;
    callback external_colour_change();
    external_colour_change() => {
        c1.colourbox = AuraPageData.led_mode_data.colour1;
        c1.final_colour = AuraPageData.led_mode_data.colour1;
        c1.external_colour_change();
        c2.colourbox = AuraPageData.led_mode_data.colour2;
        c2.final_colour = AuraPageData.led_mode_data.colour2;
        c2.external_colour_change();
    }

    property <length> content-width: root.width - Theme.space-lg * 2;
    property <length> card-inner-width: root.content-width - Theme.space-md * 2;
    // `New` and `Tuf` share the same power-zone editor; only `Old` differs.
    property <bool> zone_editor: AuraPageData.device_type == AuraDevType.New
        || AuraPageData.device_type == AuraDevType.Tuf;

    ScrollView {
        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-md;
            alignment: start;

            SectionTitle {
                icon: @image-url("../icons/lightbulb.svg");
                accent: Theme.accent-keyboard;
                title: @tr("Aura mode");
                status: AuraPageData.current_available_mode >= 0
                    && AuraPageData.current_available_mode < AuraPageData.available_mode_names.length
                    ? AuraPageData.available_mode_names[AuraPageData.current_available_mode] : "";
            }

            // ── Effect and colours ──────────────────────────────────────
            SectionCard {
                SectionTitle {
                    icon: @image-url("../icons/palette.svg");
                    accent: Theme.accent-keyboard;
                    title: @tr("Effect");
                }

                HorizontalLayout {
                    width: root.card-inner-width;
                    spacing: Theme.space-md;
                    cross-axis-alignment: center;

                    Text {
                        width: 150px;
                        text: @tr("Brightness");
                        font-size: Theme.font-base;
                        color: Theme.text-control;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {}

                    Select {
                        min-width: 200px;
                        accent: Theme.accent-keyboard;
                        model <=> AuraPageData.brightness_names;
                        current-index <=> AuraPageData.brightness;
                        text: AuraPageData.brightness >= 0 && AuraPageData.brightness < AuraPageData.brightness_names.length
                            ? AuraPageData.brightness_names[AuraPageData.brightness] : "";
                        selected(i) => {
                            AuraPageData.cb_brightness(i);
                        }
                    }
                }

                HorizontalLayout {
                    width: root.card-inner-width;
                    spacing: Theme.space-md;
                    cross-axis-alignment: center;

                    Text {
                        width: 150px;
                        text: @tr("Aura mode");
                        font-size: Theme.font-base;
                        color: Theme.text-control;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {}

                    Select {
                        min-width: 200px;
                        accent: Theme.accent-keyboard;
                        model <=> AuraPageData.available_mode_names;
                        current-index <=> AuraPageData.current_available_mode;
                        text: AuraPageData.current_available_mode >= 0
                            && AuraPageData.current_available_mode < AuraPageData.available_mode_names.length
                            ? AuraPageData.available_mode_names[AuraPageData.current_available_mode] : "";
                        selected(i) => {
                            AuraPageData.apply_effect({
                                mode: i >= 0 && i < AuraPageData.supported_basic_modes.length
                                    ? AuraPageData.supported_basic_modes[i] : 0,
                                zone: AuraPageData.led_mode_data.zone,
                                colour1: AuraPageData.led_mode_data.colour1,
                                colour2: AuraPageData.led_mode_data.colour2,
                                speed: AuraPageData.led_mode_data.speed,
                                direction: AuraPageData.led_mode_data.direction,
                            });
                        }
                    }
                }

                HorizontalLayout {
                    width: root.card-inner-width;
                    spacing: Theme.space-lg;

                    VerticalLayout {
                        width: (root.card-inner-width - Theme.space-lg) / 2;
                        spacing: Theme.space-xs;

                        Text {
                            text: @tr("Colour 1");
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                        }

                        c1 := ColourSlider {
                            height: 152px;
                            enabled: AuraPageData.colour1_enabled;
                            final_colour <=> AuraPageData.color1;
                            colourbox <=> AuraPageData.colorbox1;
                            set_hex_from_colour(c) => { return AuraPageData.cb_hex_from_colour(c); }
                            hex_to_colour(s) => { return AuraPageData.cb_hex_to_colour(s); }
                            released => {
                                AuraPageData.apply_effect({
                                    mode: AuraPageData.led_mode_data.mode,
                                    zone: AuraPageData.led_mode_data.zone,
                                    colour1: AuraPageData.color1,
                                    colour2: AuraPageData.led_mode_data.colour2,
                                    speed: AuraPageData.led_mode_data.speed,
                                    direction: AuraPageData.led_mode_data.direction,
                                });
                            }
                        }
                    }

                    VerticalLayout {
                        width: (root.card-inner-width - Theme.space-lg) / 2;
                        spacing: Theme.space-xs;

                        Text {
                            text: @tr("Colour 2");
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                        }

                        c2 := ColourSlider {
                            height: 152px;
                            enabled: AuraPageData.colour2_enabled;
                            final_colour <=> AuraPageData.color2;
                            colourbox <=> AuraPageData.colorbox2;
                            set_hex_from_colour(c) => { return AuraPageData.cb_hex_from_colour(c); }
                            hex_to_colour(s) => { return AuraPageData.cb_hex_to_colour(s); }
                            released => {
                                AuraPageData.apply_effect({
                                    mode: AuraPageData.led_mode_data.mode,
                                    zone: AuraPageData.led_mode_data.zone,
                                    colour1: AuraPageData.led_mode_data.colour1,
                                    colour2: AuraPageData.color2,
                                    speed: AuraPageData.led_mode_data.speed,
                                    direction: AuraPageData.led_mode_data.direction,
                                });
                            }
                        }
                    }

                }
            }

            // ── Zone / direction / speed ────────────────────────────────
            SectionCard {
                SectionTitle {
                    icon: @image-url("../icons/sliders-horizontal.svg");
                    accent: Theme.accent-keyboard;
                    title: @tr("Effect options");
                }

                HorizontalLayout {
                    width: root.card-inner-width;
                    spacing: Theme.space-md;
                    cross-axis-alignment: center;

                    Text {
                        width: 150px;
                        text: @tr("Zone");
                        font-size: Theme.font-base;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }

                    Rectangle {}

                    Select {
                        min-width: 200px;
                        accent: Theme.accent-keyboard;
                        enabled: false;
                        model <=> AuraPageData.zone_names;
                        current-index <=> AuraPageData.zone;
                        text: AuraPageData.zone >= 0 && AuraPageData.zone < AuraPageData.zone_names.length
                            ? AuraPageData.zone_names[AuraPageData.zone] : "";
                        selected(i) => {
                            AuraPageData.apply_effect({
                                mode: AuraPageData.led_mode_data.mode,
                                zone: i,
                                colour1: AuraPageData.led_mode_data.colour1,
                                colour2: AuraPageData.led_mode_data.colour2,
                                speed: AuraPageData.led_mode_data.speed,
                                direction: AuraPageData.led_mode_data.direction,
                            });
                        }
                    }
                }

                HorizontalLayout {
                    width: root.card-inner-width;
                    spacing: Theme.space-md;
                    cross-axis-alignment: center;

                    Text {
                        width: 150px;
                        text: @tr("Direction");
                        font-size: Theme.font-base;
                        color: Theme.text-control;
                        vertical-alignment: center;
                    }

                    Rectangle {}

                    Select {
                        min-width: 200px;
                        accent: Theme.accent-keyboard;
                        enabled: AuraPageData.direction_enabled;
                        model <=> AuraPageData.direction_names;
                        current-index <=> AuraPageData.direction;
                        text: AuraPageData.direction >= 0 && AuraPageData.direction < AuraPageData.direction_names.length
                            ? AuraPageData.direction_names[AuraPageData.direction] : "";
                        selected(i) => {
                            AuraPageData.apply_effect({
                                mode: AuraPageData.led_mode_data.mode,
                                zone: AuraPageData.led_mode_data.zone,
                                colour1: AuraPageData.led_mode_data.colour1,
                                colour2: AuraPageData.led_mode_data.colour2,
                                speed: AuraPageData.led_mode_data.speed,
                                direction: i,
                            });
                        }
                    }
                }

                HorizontalLayout {
                    width: root.card-inner-width;
                    spacing: Theme.space-md;
                    cross-axis-alignment: center;

                    Text {
                        width: 150px;
                        text: @tr("Speed");
                        font-size: Theme.font-base;
                        color: Theme.text-control;
                        vertical-alignment: center;
                    }

                    Rectangle {}

                    Select {
                        min-width: 200px;
                        accent: Theme.accent-keyboard;
                        enabled: AuraPageData.speed_enabled;
                        model <=> AuraPageData.speed_names;
                        current-index <=> AuraPageData.speed;
                        text: AuraPageData.speed >= 0 && AuraPageData.speed < AuraPageData.speed_names.length
                            ? AuraPageData.speed_names[AuraPageData.speed] : "";
                        selected(i) => {
                            AuraPageData.apply_effect({
                                mode: AuraPageData.led_mode_data.mode,
                                zone: AuraPageData.led_mode_data.zone,
                                colour1: AuraPageData.led_mode_data.colour1,
                                colour2: AuraPageData.led_mode_data.colour2,
                                speed: i,
                                direction: AuraPageData.led_mode_data.direction,
                            });
                        }
                    }
                }

                HorizontalLayout {
                    width: root.card-inner-width;
                    spacing: Theme.space-sm;
                    alignment: end;

                    GhostButton {
                        icon: @image-url("../icons/power.svg");
                        accent: Theme.accent-keyboard;
                        label: @tr("Power Settings");
                        clicked => {
                            root.show_aura_power = true;
                        }
                    }
                }
            }
        }
    }

    // ── Power settings overlay: New / TUF zones ─────────────────────────
    if root.show_aura_power && root.zone_editor: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface-base;

        ScrollView {
            VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-sm;
                alignment: start;

                for state[idx] in AuraPageData.led_power.states: zone := AuraPowerGroup {
                    width: root.content-width;
                    group-title: AuraPageData.power_zone_names[state.zone_name_idx];
                    // TODO: use the zone name
                    boot_checked: state.boot;
                    boot_toggled(v) => {
                        AuraPageData.led_power.states[idx].boot = v;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                    awake_checked: state.awake;
                    awake_toggled(v) => {
                        AuraPageData.led_power.states[idx].awake = v;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                    sleep_checked: state.sleep;
                    sleep_toggled(v) => {
                        AuraPageData.led_power.states[idx].sleep = v;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                    shutdown_checked: state.shutdown;
                    shutdown_toggled(v) => {
                        AuraPageData.led_power.states[idx].shutdown = v;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                }
            }
        }
    }

    // ── Power settings overlay: legacy zones ────────────────────────────
    if root.show_aura_power && AuraPageData.device_type == AuraDevType.Old: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface-base;

        ScrollView {
            VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-sm;
                alignment: start;

                for state[idx] in AuraPageData.led_power.states: old_zone := AuraPowerGroupOld {
                    width: root.content-width;
                    group-title: @tr("Power Zones");
                    zone_strings <=> AuraPageData.power_zone_names_old;
                    selected_zone(i) => {
                        AuraPageData.led_power.states[idx].zone = AuraPageData.supported_power_zones[i];
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                    boot_checked: state.boot;
                    boot_toggled(v) => {
                        AuraPageData.led_power.states[idx].boot = v;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                    awake_checked: state.awake;
                    awake_toggled(v) => {
                        AuraPageData.led_power.states[idx].awake = v;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                    sleep_checked: state.sleep;
                    sleep_toggled(v) => {
                        AuraPageData.led_power.states[idx].sleep = v;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                }
            }
        }
    }

    if root.show_aura_power: GhostButton {
        x: root.width - self.width - Theme.space-lg;
        y: Theme.space-lg;
        icon: @image-url("../icons/x.svg");
        accent: Theme.status-danger;
        label: @tr("Close");
        clicked => {
            root.show_aura_power = false;
        }
    }
}
