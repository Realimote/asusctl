// Cooling / fan-curve chart.
//
// Drawn by hand instead of with std-widgets: Slint's `Palette` global is
// read-only apart from `color-scheme`, so the standard widgets cannot be
// re-themed, and the design calls for a gradient area chart with draggable
// nodes.
//
// Two Slint limitations shape the implementation:
//   * `for`-`in` cannot generate `Path` sub-elements (slint issue #754), so the
//     curve and the area are built from one `Path` per segment.
//   * `Path` has no dash support, so the cursor line is a column of short
//     segments.
// The area's vertical fade is therefore a gradient overlay on top of a flat
// translucent fill, which also fades the lower part of the grid.
//
// The drag-constraint logic (`check()` and the four `scale_*` helpers) is
// deliberately unchanged from the original implementation: it mirrors the curve
// validation done by the daemon, and reworking it is a separate concern.
import { Theme } from "theme.slint";

export struct Node { x: length, y: length }

export component Graph inherits Rectangle {
    in-out property <[Node]> nodes;
    in property <Node> node_min: { x: 0px, y: 0px };
    in property <Node> node_max: { x: 100px, y: 255px };
    property <length> graph_padding: 40px;
    property <length> axis_font_size: Theme.font-sm;
    // Chart colour. The fans page is the only consumer today and uses the
    // thermal accent.
    in property <color> accent: Theme.accent-thermal;
    // Node currently being dragged (or last touched) — draws the cursor line.
    in-out property <int> active_node: -1;

    background: transparent;

    graph := Rectangle {
        width: root.width - root.graph_padding * 2;
        height: root.height - root.graph_padding * 2;
        x: root.graph_padding;
        y: root.graph_padding;
        border-radius: Theme.radius-md;
        background: Theme.surface-sunken;
        border-width: 1px;
        border-color: Theme.border;

        function scale_x_to_graph(x: length) -> length {
            ((x - node_min.x) / (node_max.x - node_min.x)) * graph.width
        }
        //
        function scale_y_to_graph(y: length) -> length {
            ((y - node_min.y) / (node_max.y - node_min.y)) * graph.height
        }
        //
        function scale_x_to_node(x: length) -> length {
            (x / graph.width) * (node_max.x - node_min.x)
        }
        //
        function scale_y_to_node(y: length) -> length {
            (y / graph.height) * (node_max.y - node_min.y)
        }
        //

        // ── Grid ────────────────────────────────────────────────────────
        for n in 11: Rectangle {
            x: scale_x_to_graph(n * 10px);
            y: 0px;
            width: 1px;
            height: graph.height;
            background: Theme.border;
        }

        for n in 11: Rectangle {
            x: 0px;
            y: graph.height - scale_y_to_graph(n * 25.5px);
            width: graph.width;
            height: 1px;
            background: Theme.border;
        }

        // ── Area under the curve ────────────────────────────────────────
        // One trapezoid per segment. The right edge is nudged out by 0.75px so
        // neighbouring translucent shapes overlap instead of leaving a seam.
        for l[idx] in nodes: Rectangle {
            if idx + 1 != nodes.length: Path {
                viewbox-width: graph.width / 1px;
                viewbox-height: graph.height / 1px;
                fill: root.accent.with-alpha(0.22);

                MoveTo {
                    x: scale_x_to_graph(nodes[idx].x) / 1px;
                    y: graph.height / 1px - scale_y_to_graph(nodes[idx].y) / 1px;
                }

                LineTo {
                    x: (scale_x_to_graph(nodes[idx + 1].x) + 0.75px) / 1px;
                    y: graph.height / 1px - scale_y_to_graph(nodes[idx + 1].y) / 1px;
                }

                LineTo {
                    x: (scale_x_to_graph(nodes[idx + 1].x) + 0.75px) / 1px;
                    y: graph.height / 1px;
                }

                LineTo {
                    x: scale_x_to_graph(nodes[idx].x) / 1px;
                    y: graph.height / 1px;
                }

                Close { }
            }
        }

        // ── Vertical fade (this is what makes the fill a gradient) ──────
        Rectangle {
            x: 0px;
            y: 0px;
            width: graph.width;
            height: graph.height;
            background: @linear-gradient(180deg, root.accent.with-alpha(0) 0%, Theme.surface-sunken.with-alpha(0.85) 100%);
        }

        // ── Curve ───────────────────────────────────────────────────────
        for l[idx] in nodes: Rectangle {
            if idx + 1 != nodes.length: Path {
                viewbox-width: graph.width / 1px;
                viewbox-height: graph.height / 1px;
                stroke: root.accent;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;

                MoveTo {
                    x: scale_x_to_graph(nodes[idx].x) / 1px;
                    y: graph.height / 1px - scale_y_to_graph(nodes[idx].y) / 1px;
                }

                LineTo {
                    x: scale_x_to_graph(nodes[idx + 1].x) / 1px;
                    y: graph.height / 1px - scale_y_to_graph(nodes[idx + 1].y) / 1px;
                }
            }
        }

        // ── Cursor line at the active node ──────────────────────────────
        if root.active_node >= 0 && root.active_node < nodes.length: Rectangle {
            x: scale_x_to_graph(nodes[root.active_node].x) - 0.5px;
            y: 0px;
            width: 1px;
            height: graph.height;
            background: transparent;

            for k in 10: Rectangle {
                y: graph.height / 10 * k;
                width: 1px;
                height: graph.height / 10 * 0.5;
                background: root.accent;
                opacity: 0.5;
            }
        }

        // ── Draggable nodes ─────────────────────────────────────────────
        for n[idx] in nodes: Rectangle {
            states [
                pressed when touch.pressed: {
                    point.background: root.accent;
                    point.border-color: root.accent;
                    tip.border-color: root.accent;
                    tip.opacity: 1.0;
                    label.color: root.accent;
                }
                hover when touch.has-hover: {
                    point.background: root.accent;
                    point.border-color: root.accent;
                    tip.border-color: root.accent;
                    tip.opacity: 1.0;
                    label.color: root.accent;
                }
            ]
            //
            point := Rectangle {
                background: Theme.surface-card;
                border-width: 2px;
                border-color: root.accent;
                x: scale_x_to_graph(n.x) - self.width / 2;
                y: graph.height - scale_y_to_graph(n.y) - self.height / 2;
                width: 14px;
                height: self.width;
                border-radius: self.width / 2;
                drop-shadow-blur: 10px;
                drop-shadow-color: root.accent.with-alpha(0.45);
                property <length> pad: 1px;

                touch := TouchArea {
                    function check() {
                        if idx + 1 < nodes.length && idx > 0 {
                            if n.x + scale_x_to_node(self.mouse-x - self.pressed-x) > nodes[idx + 1].x {
                                n.x = nodes[idx + 1].x - pad;
                            } else if n.x + scale_x_to_node(self.mouse-x - self.pressed-x) < nodes[idx - 1].x {
                                n.x = nodes[idx - 1].x + pad;
                            }
                            if n.y + scale_y_to_node(self.height - self.mouse-y - self.pressed-y) > nodes[idx + 1].y {
                                n.y = nodes[idx + 1].y - pad;
                            } else if n.y + scale_y_to_node(self.height - self.mouse-y - self.pressed-y) < nodes[idx - 1].y {
                                n.y = nodes[idx - 1].y + pad;
                            }
                        } else if idx == 0 {
                            if n.x + scale_x_to_node(self.mouse-x - self.pressed-x) < 0.0 {
                                n.x = 1px;
                            } else if n.x + scale_x_to_node(self.mouse-x - self.pressed-x) > nodes[idx + 1].x {
                                n.x = nodes[idx + 1].x - pad;
                            }
                            if n.y - scale_y_to_node(self.mouse-y - self.pressed-y) < 0.0 {
                                n.y = 1px;
                            } else if n.y + scale_y_to_node(self.height - self.mouse-y - self.pressed-y) > nodes[idx + 1].y {
                                n.y = nodes[idx + 1].y - pad;
                            }
                        } else if idx == nodes.length - 1 {
                            if n.x + scale_x_to_node(self.mouse-x - self.pressed-x) > scale_x_to_node(graph.width) {
                                n.x = scale_x_to_node(graph.width - 1px);
                            } else if n.x + scale_x_to_node(self.mouse-x - self.pressed-x) < nodes[idx - 1].x {
                                n.x = nodes[idx - 1].x + pad;
                            }
                            if n.y - scale_y_to_node(self.mouse-y - self.pressed-y) > scale_y_to_node(graph.height) {
                                n.y = scale_y_to_node(graph.height - 1px);
                            } else if n.y + scale_y_to_node(self.height - self.mouse-y - self.pressed-y) < nodes[idx - 1].y {
                                n.y = nodes[idx - 1].y + pad;
                            }
                        }
                    }
                    //
                    moved => {
                        if (self.pressed) {
                            root.active_node = idx;
                            n.x += scale_x_to_node(self.mouse-x - self.pressed-x);
                            n.y -= scale_y_to_node(self.mouse-y - self.pressed-y);
                            self.check();
                            // nodes[idx] = n;
                        }
                    }

                    clicked => {
                        root.active_node = idx;
                        self.check();
                    }
                    mouse-cursor: move;
                }
            }

            tip := Rectangle {
                background: Theme.surface-raised;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius-sm;
                opacity: 0.75;
                x: final_x_pos();
                y: final_y_pos();
                width: label.preferred-width + 14px;
                height: label.preferred-height + 6px;
                function x_pos() -> length {
                    scale_x_to_graph(n.x) - label.preferred-width - 10px
                }
                //
                function final_x_pos() -> length {
                    if x_pos() > 0 {
                        x_pos()
                    } else {
                        x_pos() + label.preferred-width
                    }
                }
                //
                function y_pos() -> length {
                    graph.height - scale_y_to_graph(n.y) - self.height - 6px
                }
                //
                function final_y_pos() -> length {
                    if y_pos() > 0 {
                        y_pos()
                    } else {
                        y_pos() + label.preferred-height
                    }
                }
                //
                function fan_pct() -> int {
                    Math.floor(n.y / 1px) / 255 * 100
                }
                //
                label := Text {
                    color: Theme.text-control;
                    font-size: Theme.font-sm;
                    x: 7px;
                    y: 3px;
                    text: "\{Math.floor(n.x / 1px)}c, \{fan_pct()}%";
                }
            }
        }
    }

    // ── Axis labels ─────────────────────────────────────────────────────
    // Kept outside the plot panel so they are not drawn over its border.
    for n in 11: Text {
        color: Theme.text-muted;
        font-size: root.axis_font_size;
        text: "\{n * 10}c";
        x: graph.x + graph.scale_x_to_graph(n * 10px) - self.width / 2;
        y: graph.y + graph.height + 4px;
    }

    for n in 11: Text {
        color: Theme.text-muted;
        font-size: root.axis_font_size;
        text: "\{n * 10}%";
        x: graph.x - self.width - 6px;
        y: graph.y + graph.height - graph.scale_y_to_graph(n * 25.5px) - self.height / 2;
    }
}
