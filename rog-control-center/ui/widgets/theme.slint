// Central design tokens for the whole app. Every page and widget must pull
// colours, spacing, radii and font sizes from here so the UI stays coherent.
//
// Visual language: dark "cyber" gaming aesthetic — near-black layered
// surfaces, hairline borders, per-page accent colours and accent glows.
// Every value below is a fixed literal, deliberately independent of the
// Slint style palette: the standard widgets' `Palette` global is read-only
// (only `color-scheme` is writable), so themes have to own their colours
// rather than remap the fluent palette.

export global Theme {
    // ── Surfaces ────────────────────────────────────────────────────────
    // Page backdrop, cards / top bar, hover-and-selected rows, recessed wells.
    out property <color> surface-base: #0e1118;
    out property <color> surface-card: #13181e;
    out property <color> surface-raised: #1c2229;
    out property <color> surface-sunken: #0a0d13;
    // Alias kept for the pages that still paint their background with
    // `surface`; it is the page backdrop, not a card colour.
    out property <color> surface: #0e1118;

    // ── Hairlines ───────────────────────────────────────────────────────
    out property <color> border: #252a30;
    out property <color> border-strong: #333a44;

    // ── Text ────────────────────────────────────────────────────────────
    out property <color> text: #e6e9ef;
    out property <color> text-control: #c7cdd6;
    out property <color> text-muted: #768094;
    out property <color> text-dim: #4e5866;

    // ── Semantic status colours (temp, battery health, banners) ─────────
    out property <color> status-ok: #22c55e;
    out property <color> status-warn: #f59e0b;
    out property <color> status-danger: #ef4444;

    // ── Per-page accents (this is the "cyber" zoning) ───────────────────
    out property <color> accent: #2bbbf8;
    out property <color> accent-overview: #2bbbf8;
    out property <color> accent-lighting: #9f51ff;
    out property <color> accent-thermal: #22c3ed;
    out property <color> accent-system: #38bdf8;
    out property <color> accent-settings: #a78bfa;
    out property <color> accent-about: #f472b6;

    // ── Section accents, shared by the dashboard and page headers ───────
    out property <color> accent-perf: #ef4444;
    out property <color> accent-gpu: #2bbbf8;
    out property <color> accent-display: #a855f7;
    out property <color> accent-battery: #22c55e;
    out property <color> accent-keyboard: #9f51ff;
    out property <color> accent-slash: #f59e0b;

    // ── Foregrounds on accent fills ─────────────────────────────────────
    out property <color> accent-foreground: #0a0d13;
    out property <color> selection: #1c343e;

    // ── Spacing ─────────────────────────────────────────────────────────
    out property <length> space-xs: 4px;
    out property <length> space-sm: 6px;
    out property <length> space-md: 10px;
    out property <length> space-lg: 14px;
    out property <length> space-xl: 20px;

    // ── Corner radii ────────────────────────────────────────────────────
    // chips and small controls, rows and buttons, cards, overlays
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 12px;
    out property <length> radius-xl: 16px;

    // ── Type scale ──────────────────────────────────────────────────────
    out property <length> font-xs: 11px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 13px;
    out property <length> font-base: 14px;
    out property <length> font-lg: 16px;
    out property <length> font-xl: 18px;
    out property <length> font-title: 20px;
    // Large readouts in the metric tiles.
    out property <length> font-metric: 26px;

    // ── Fixed metrics ───────────────────────────────────────────────────
    out property <length> row-height: 40px;
    out property <length> topbar-height: 50px;
    out property <length> nav-height: 56px;

    // ── Accent glow, used by selected/active elements ───────────────────
    out property <length> glow-blur: 16px;
    out property <float> glow-alpha: 0.35;
}
