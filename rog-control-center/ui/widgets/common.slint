// Row-style controls shared by the settings-like pages: sliders, toggles and
// dropdowns rendered as rounded cards. Their properties and callbacks are
// bound from Rust (setup_*.rs) so the public API must stay stable.
import { Palette, VerticalBox, StandardButton, Button, HorizontalBox, ComboBox, Switch, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Base card for a single control row.
export component RogItem inherits Rectangle {
    background: Theme.surface-card;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-md;
    min-height: Theme.row-height;
    max-height: Theme.row-height;
}

export component SystemSlider inherits RogItem {
    in property <string> title;
    in property <string> text;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    callback released(float);

    in property <string> help_text;
    in property <bool> enabled: true;
    in property <bool> has_reset: false;
    callback cb_do_reset();

    HorizontalLayout {
        HorizontalLayout {
            width: 40%;
            alignment: LayoutAlignment.stretch;
            padding-left: Theme.space-md;
            HorizontalLayout {
                spacing: Theme.space-xs;
                Text {
                    font-size: Theme.font-base;
                    vertical-alignment: TextVerticalAlignment.center;
                    color: Theme.text-control;
                    text: root.text;
                    overflow: elide;
                }

                Text {
                    font-size: Theme.font-base;
                    font-weight: 600;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                    color: Theme.text-control;
                    text: "\{Math.round(root.value)}";
                }
            }
        }

        HorizontalBox {
            padding-right: Theme.space-md;
            slider := Slider {
                enabled: root.enabled;
                maximum: root.maximum;
                minimum: root.minimum;
                value <=> root.value;
                released(value) => {
                    root.released(value)
                }
            }
        }

        help_popup := PopupWindow {
            x: help.x - self.width + help.width - Theme.space-sm;
            y: help.y - self.height + help.height - Theme.space-sm;
            Rectangle {
                drop-shadow-blur: 10px;
                drop-shadow-color: Colors.black.with-alpha(0.6);
                border-radius: Theme.radius-lg;
                border-color: Theme.border;
                background: Theme.surface;
                Dialog {
                    title: root.title;
                    VerticalBox {
                        Text {
                            max-width: 420px;
                            font-size: Theme.font-lg;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            text: root.title;
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        Text {
                            max-width: 420px;
                            font-size: Theme.font-base;
                            wrap: TextWrap.word-wrap;
                            text: root.help_text;
                        }
                    }

                    StandardButton {
                        kind: ok;
                    }
                }
            }
        }

        help := HorizontalBox {
            if (help_text != ""): StandardButton {
                kind: StandardButtonKind.help;
                clicked => {
                    help_popup.show();
                }
            }
        }

        reset_popup := PopupWindow {
            x: reset.x - self.width + reset.width;
            y: reset.y - self.height + reset.height;
            Rectangle {
                drop-shadow-blur: 10px;
                drop-shadow-color: Colors.black.with-alpha(0.6);
                border-radius: Theme.radius-lg;
                border-color: Theme.border;
                background: Theme.surface;
                Dialog {
                    Text {
                        max-width: 420px;
                        font-size: Theme.font-base;
                        wrap: TextWrap.word-wrap;
                        text: @tr("confirm_reset" => "Are you sure you want to reset this?");
                    }

                    StandardButton {
                        kind: ok;
                        clicked => {
                            root.cb_do_reset();
                        }
                    }

                    StandardButton {
                        kind: cancel;
                    }
                }
            }
        }

        reset := HorizontalBox {
            if (has_reset): StandardButton {
                kind: StandardButtonKind.reset;
                enabled: root.enabled;
                clicked => {
                    reset_popup.show();
                }
            }
        }
    }
}

export component SystemToggle inherits RogItem {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);
    HorizontalLayout {
        spacing: Theme.space-xs;
        HorizontalLayout {
            alignment: LayoutAlignment.start;
            padding-left: Theme.space-md;
            Text {
                font-size: Theme.font-base;
                vertical-alignment: TextVerticalAlignment.center;
                color: Theme.text-control;
                text: root.text;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            padding-right: Theme.space-lg;
            Switch {
                enabled: root.enabled;
                checked <=> root.checked;
                toggled => {
                    root.toggled(root.checked)
                }
            }
        }
    }
}

export component SystemToggleInt inherits RogItem {
    in property <string> text;
    // in-out property <bool> checked;
    in-out property <int> checked_int;
    callback toggled(int);
    HorizontalLayout {
        spacing: Theme.space-xs;
        HorizontalLayout {
            alignment: LayoutAlignment.start;
            padding-left: Theme.space-md;
            Text {
                font-size: Theme.font-base;
                vertical-alignment: TextVerticalAlignment.center;
                color: Theme.text-control;
                text: root.text;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            padding-right: Theme.space-lg;
            Switch {
                checked: root.checked_int != 0;
                toggled => {
                    root.checked_int = self.checked ? 1 : 0;
                    root.toggled(root.checked_int);
                }
            }
        }
    }
}

export component SystemToggleVert inherits RogItem {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    min-height: 86px;
    VerticalLayout {
        alignment: LayoutAlignment.space-around;
        padding-top: Theme.space-sm;
        Text {
            font-size: Theme.font-base;
            vertical-alignment: TextVerticalAlignment.bottom;
            horizontal-alignment: TextHorizontalAlignment.center;
            color: Theme.text-control;
            text: root.text;
        }

        HorizontalLayout {
            alignment: LayoutAlignment.center;
            padding-bottom: Theme.space-sm;
            Switch {
                checked <=> root.checked;
                toggled => {
                    root.toggled(root.checked)
                }
            }
        }
    }
}

export component SystemDropdown inherits RogItem {
    in property <string> text;
    in-out property <int> current_index;
    in-out property <string> current_value;
    in-out property <[string]> model;
    in property <bool> enabled: true;
    // mirrors the fluent ComboBox default; raise it to widen a specific dropdown
    in property <length> combo_min_width: 160px;
    callback selected(int);
    HorizontalLayout {
        HorizontalLayout {
            alignment: LayoutAlignment.start;
            padding-left: Theme.space-md;
            Text {
                font-size: Theme.font-base;
                vertical-alignment: TextVerticalAlignment.center;
                color: Theme.text-control;
                text: root.text;
                overflow: elide;
            }
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            padding-right: Theme.space-lg;
            padding-top: 7px;
            padding-bottom: 7px;
            ComboBox {
                min-width: root.combo_min_width;
                model <=> root.model;
                current-index <=> root.current_index;
                current-value <=> root.current_value;
                enabled: root.enabled;
                selected => {
                    root.selected(root.current_index)
                }
            }
        }
    }
}
