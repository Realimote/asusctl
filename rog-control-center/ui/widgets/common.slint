// Row-style controls shared by the settings-like pages: sliders, toggles and
// dropdowns rendered as rounded cards.
//
// The public API here is bound from Rust (`setup_*.rs`) and from `system.slint`,
// so the property and callback names must stay stable. Only the internals were
// swapped from std-widgets to the hand-drawn controls in `cyber.slint`, because
// Slint's `Palette` is read-only and the standard widgets cannot be re-themed.
import { Theme } from "theme.slint";
import { CyberSlider, MiniSwitch, Select, GhostButton } from "cyber.slint";

// Base card for a single control row.
export component RogItem inherits Rectangle {
    background: Theme.surface-card;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-md;
    min-height: Theme.row-height;
    max-height: Theme.row-height;
}

export component SystemSlider inherits RogItem {
    in property <string> title;
    in property <string> text;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    callback released(float);

    in property <string> help_text;
    in property <bool> enabled: true;
    in property <bool> has_reset: false;
    callback cb_do_reset();

    HorizontalLayout {
        HorizontalLayout {
            width: 40%;
            alignment: stretch;
            padding-left: Theme.space-md;
            cross-axis-alignment: center;
            HorizontalLayout {
                spacing: Theme.space-xs;
                Text {
                    font-size: Theme.font-base;
                    vertical-alignment: center;
                    color: Theme.text-control;
                    text: root.text;
                    overflow: elide;
                }

                Text {
                    font-size: Theme.font-base;
                    font-weight: 600;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Theme.accent;
                    text: "\{Math.round(root.value)}";
                }
            }
        }

        HorizontalLayout {
            padding-right: Theme.space-md;
            cross-axis-alignment: center;

            CyberSlider {
                width: 100%;
                accent: Theme.accent-system;
                enabled: root.enabled;
                maximum: root.maximum;
                minimum: root.minimum;
                value <=> root.value;
                released(v) => {
                    root.released(v)
                }
            }
        }

        help_popup := PopupWindow {
            x: help.x - self.width + help.width - Theme.space-sm;
            y: help.y - self.height + help.height - Theme.space-sm;
            Rectangle {
                drop-shadow-blur: 16px;
                drop-shadow-color: Colors.black.with-alpha(0.6);
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border-strong;
                background: Theme.surface-raised;

                VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;
                    alignment: start;

                    Text {
                        text: root.title;
                        font-size: Theme.font-lg;
                        font-weight: 700;
                        color: Theme.text;
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    Text {
                        max-width: 420px;
                        font-size: Theme.font-base;
                        color: Theme.text-control;
                        wrap: word-wrap;
                        text: root.help_text;
                    }

                    HorizontalLayout {
                        alignment: end;
                        GhostButton {
                            label: @tr("OK");
                            accent: Theme.accent-system;
                            clicked => {
                                help_popup.close();
                            }
                        }
                    }
                }
            }
        }

        help := HorizontalLayout {
            alignment: center;
            padding-right: Theme.space-xs;
            if (help_text != ""): GhostButton {
                min-width: 62px;
                accent: Theme.text-muted;
                label: @tr("Help");
                clicked => {
                    help_popup.show();
                }
            }
        }

        reset_popup := PopupWindow {
            x: reset.x - self.width + reset.width;
            y: reset.y - self.height + reset.height;
            Rectangle {
                drop-shadow-blur: 16px;
                drop-shadow-color: Colors.black.with-alpha(0.6);
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border-strong;
                background: Theme.surface-raised;

                VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;
                    alignment: start;

                    Text {
                        max-width: 420px;
                        font-size: Theme.font-base;
                        color: Theme.text;
                        wrap: word-wrap;
                        text: @tr("confirm_reset" => "Are you sure you want to reset this?");
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: Theme.space-sm;

                        GhostButton {
                            label: @tr("Cancel");
                            accent: Theme.text-muted;
                            clicked => {
                                reset_popup.close();
                            }
                        }

                        GhostButton {
                            label: @tr("OK");
                            accent: Theme.status-danger;
                            clicked => {
                                root.cb_do_reset();
                                reset_popup.close();
                            }
                        }
                    }
                }
            }
        }

        reset := HorizontalLayout {
            alignment: center;
            if (has_reset): GhostButton {
                min-width: 62px;
                accent: Theme.accent-system;
                enabled: root.enabled;
                label: @tr("Reset");
                clicked => {
                    reset_popup.show();
                }
            }
        }
    }
}

export component SystemToggle inherits RogItem {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);
    HorizontalLayout {
        spacing: Theme.space-xs;
        cross-axis-alignment: center;

        HorizontalLayout {
            alignment: start;
            padding-left: Theme.space-md;
            Text {
                font-size: Theme.font-base;
                vertical-alignment: center;
                color: Theme.text-control;
                text: root.text;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        Rectangle {}

        HorizontalLayout {
            alignment: end;
            padding-right: Theme.space-lg;

            MiniSwitch {
                enabled: root.enabled;
                accent: Theme.accent-system;
                checked <=> root.checked;
                toggled => {
                    root.toggled(root.checked)
                }
            }
        }
    }
}

export component SystemToggleInt inherits RogItem {
    in property <string> text;
    in-out property <int> checked_int;
    callback toggled(int);
    HorizontalLayout {
        spacing: Theme.space-xs;
        cross-axis-alignment: center;

        HorizontalLayout {
            alignment: start;
            padding-left: Theme.space-md;
            Text {
                font-size: Theme.font-base;
                vertical-alignment: center;
                color: Theme.text-control;
                text: root.text;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        Rectangle {}

        HorizontalLayout {
            alignment: end;
            padding-right: Theme.space-lg;

            MiniSwitch {
                accent: Theme.accent-system;
                checked: root.checked_int != 0;
                toggled => {
                    root.checked_int = self.checked ? 1 : 0;
                    root.toggled(root.checked_int);
                }
            }
        }
    }
}

export component SystemDropdown inherits RogItem {
    in property <string> text;
    in-out property <int> current_index;
    in-out property <string> current_value;
    in-out property <[string]> model;
    in property <bool> enabled: true;
    // mirrors the old ComboBox default; raise it to widen a specific dropdown
    in property <length> combo_min_width: 160px;
    callback selected(int);
    HorizontalLayout {
        cross-axis-alignment: center;

        HorizontalLayout {
            alignment: start;
            padding-left: Theme.space-md;
            Text {
                font-size: Theme.font-base;
                vertical-alignment: center;
                color: Theme.text-control;
                text: root.text;
                overflow: elide;
            }
        }

        Rectangle {}

        HorizontalLayout {
            alignment: end;
            padding-right: Theme.space-lg;

            Select {
                min-width: root.combo_min_width;
                accent: Theme.accent-system;
                model <=> root.model;
                current-index <=> root.current_index;
                text <=> root.current_value;
                enabled: root.enabled;
                selected(i) => {
                    root.selected(root.current_index)
                }
            }
        }
    }
}
