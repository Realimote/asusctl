import { Palette, VerticalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One entry of the slim navigation rail: an icon over a tiny label.
component RailItem inherits Rectangle {
    in property <bool> selected;
    in property <bool> has-focus;
    in property <string> icon;
    in-out property <string> text <=> label.text;
    callback clicked <=> touch.clicked;
    min-height: self.visible ? 52px : 0px;
    border-radius: Theme.radius-md;
    accessible-role: tab;

    states [
        pressed when touch.pressed: {
            state.opacity: 0.75;
        }
        hover when touch.has-hover: {
            state.opacity: 0.85;
        }
        selected when root.selected: {
            state.opacity: 1;
        }
        focused when root.has-focus: {
            state.opacity: 0.8;
        }
    ]

    state := Rectangle {
        opacity: root.selected ? 1 : 0;
        background: Theme.selection;
        border-radius: parent.border-radius;
        animate opacity { duration: 120ms; }
        height: 100%;
    }

    l := VerticalLayout {
        x: Theme.space-xs;
        y: (parent.height - self.height) / 2;
        padding-left: Theme.space-xs;
        padding-right: Theme.space-xs;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.icon;
            font-size: 17px;
            horizontal-alignment: center;
        }

        label := Text {
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: Theme.font-xs;
            overflow: elide;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
    }
}

// Slim icon navigation rail.
export component SideBar inherits Rectangle {
    in property <[string]> model: [];
    in property <[string]> icons: [];
    in property <[bool]> available: [];
    in-out property <int> current-item: 0;
    out property <int> current-focused: fs.has-focus ? fs.focused-tab : -1;
    callback exit-app;

    width: 66px;
    forward-focus: fs;
    accessible-role: tab-list;

    Rectangle {
        background: Theme.surface;

        fs := FocusScope {
            key-pressed(event) => {
                if (event.text == "\n") {
                    root.current-item = root.current-focused;
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    self.focused-tab = Math.max(self.focused-tab - 1, 0);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    self.focused-tab = Math.min(self.focused-tab + 1, root.model.length - 1);
                    return accept;
                }
                return reject;
            }
            key-released(event) => {
                if (event.text == " ") {
                    root.current-item = root.current-focused;
                    return accept;
                }
                return reject;
            }
            property <int> focused-tab: 0;
            x: 0;
            width: 0;
        }
    }

    VerticalLayout {
        spacing: Theme.space-xs;
        padding: 6px;
        padding-top: Theme.space-sm;
        alignment: start;

        Image {
            height: 40px;
            source: @image-url("../../data/rog-control-center.png");
            horizontal-alignment: center;
            image-fit: contain;
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        navigation := VerticalLayout {
            spacing: 3px;
            alignment: start;
            vertical-stretch: 0;
            for item[index] in root.model: RailItem {
                visible: root.available[index];
                clicked => {
                    root.current-item = index;
                }
                has-focus: index == root.current-focused;
                icon: root.icons[index];
                text: item;
                selected: index == root.current-item;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        exit_btn := RailItem {
            icon: "⏻";
            text: @tr("Quit App");
            clicked => {
                root.exit-app();
            }
        }
    }
}
