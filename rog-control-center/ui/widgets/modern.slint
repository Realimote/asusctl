// Shared building blocks for the card based UI: mode buttons, section
// headers, cards, page headers and info banners. All colours and metrics
// come from the Theme global so pages stay visually coherent.
import { Theme } from "theme.slint";

// Rounded card that groups one section of a page.
export component SectionCard inherits Rectangle {
    in property <length> pad: Theme.space-md;

    border-radius: Theme.radius-lg;
    background: Theme.surface-card;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: root.pad;
        spacing: Theme.space-sm;
        alignment: start;
        // Explicit `stretch` is required: Slint lays out text-bearing
        // containers with a content-measured cross axis, which would otherwise
        // shrink child rows to their preferred width instead of filling the
        // card.
        cross-axis-alignment: stretch;

        @children
    }
}

// Rounded banner for tips and warnings: a coloured left accent, translucent
// tinted background and readable text of the same hue.
export component InfoBanner inherits Rectangle {
    in property <string> text: "";
    in property <bool> danger: false;
    in property <bool> warning: false;

    private property <color> tone: root.danger ? Theme.status-danger
        : root.warning ? Theme.status-warn : Theme.accent-gpu;

    min-height: 36px;
    border-radius: Theme.radius-sm;
    background: root.tone.with-alpha(0.14);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.45);

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        spacing: Theme.space-sm;
        Text {
            text: root.danger ? "⚠" : (root.warning ? "⚠" : "ℹ");
            font-size: Theme.font-base;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: Theme.font-base;
            color: root.tone.mix(Theme.text, 40%);
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// Small text-only button used for "More" links.
export component LinkButton inherits Rectangle {
    in property <string> label: "";
    callback clicked;

    min-width: 48px;
    min-height: 26px;
    border-radius: Theme.radius-sm;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.label;
        font-size: Theme.font-md;
        font-weight: 600;
        color: Theme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    states [
        hover when ta.has-hover: {
            background: Theme.text.with-alpha(0.08);
        }
    ]
}

// Tiny rounded colour swatch showing the current Aura colour.
export component ColourSwatch inherits Rectangle {
    in property <brush> colour: Colors.orange;
    callback clicked;

    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    border-radius: 7px;
    background: root.colour;
    border-width: 1px;
    border-color: Theme.border;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    states [
        hover when ta.has-hover: {
            border-color: Theme.accent;
        }
    ]
}
